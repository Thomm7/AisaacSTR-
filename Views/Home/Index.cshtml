            </button>
          </div>
        </div>

        <!-- Tabla de Matriz de Variantes -->
        <div class="data-card">
          <div class="search-bar" style="border-bottom: 1px solid var(--border-subtle);">
            <div class="search-input-wrap inventory-search-wrap">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
              <input type="search" id="inv-search" placeholder="Buscar por SKU, código, prenda o marca..." aria-label="Filtrar inventario" oninput="filtrarTablaInventario()" />
              <span class="inventory-search-hint">⌘ K</span>
            </div>
          </div>
          <div class="table-responsive inventory-table-scroll">
            <table class="custom-table" id="tabla-inventario">
