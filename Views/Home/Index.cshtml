    <!-- ──────────────────────────────────────────
         5. PANEL: DASHBOARD GERENCIAL & ALERTAS
         ────────────────────────────────────────── -->
    <section id="panel-dashboard" class="panel">
      <div class="module-container">
        <div class="module-header">
          <div class="module-title-box">
            <h2>Dashboard Gerencial, Estadísticas y Reabastecimiento</h2>
            <p>Toma de decisiones de compra basadas en demanda real y alertas de rotación</p>
          </div>
          <button class="btn-secondary" onclick="cargarDashboard()">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
            Actualizar Métricas
          </button>
        </div>

        <!-- KPIs Cuadrícula -->
        <div class="kpi-grid-4">
          <div class="dash-kpi gold">
            <span class="dash-kpi-label">Ventas del Mes</span>
            <span class="dash-kpi-val" id="kpi-ventas-mes">$ 0</span>
            <span class="dash-kpi-sub">Facturación mensual consolidada</span>
          </div>
          <div class="dash-kpi green">
            <span class="dash-kpi-label">Ventas de Hoy</span>
            <span class="dash-kpi-val" id="kpi-ventas-hoy">$ 0</span>
            <span class="dash-kpi-sub">Ingresos jornada actual</span>
          </div>
          <div class="dash-kpi green">
            <span class="dash-kpi-label">Valorización de Stock</span>
            <span class="dash-kpi-val" id="kpi-valor-stock">$ 0</span>
            <span class="dash-kpi-sub">Total prendas a precio venta</span>
          </div>
          <div class="dash-kpi red">
            <span class="dash-kpi-label">Alertas Críticas</span>
            <span class="dash-kpi-val" id="kpi-alertas-count">0</span>
            <span class="dash-kpi-sub">Prendas con stock &le; mínimo</span>
          </div>
          <div class="dash-kpi provider-budget">
            <span class="dash-kpi-label">Presupuesto para Proveedores</span>
            <span class="dash-kpi-val" id="kpi-proveedores-disponible">$ 0</span>
            <span class="dash-kpi-sub">Fondos del mes: <b id="kpi-proveedores-fondo">$ 0</b> · Pagado: <b id="kpi-proveedores-pagado">$ 0</b></span>
            <div class="provider-budget-progress"><div id="provider-budget-progress-bar"></div></div>
          </div>
        </div>

        <!-- Secciones Divididas: Top de Prendas vs Alertas de Reabastecimiento -->
        <div class="dashboard-split">

          <!-- 1. Top de Prendas Más Vendidas por Variantes -->
          <div class="data-card" style="padding: 18px;">
            <div style="font-weight:700; color:var(--gold-bright); font-size:12px; letter-spacing:1px; text-transform:uppercase; margin-bottom: 14px;">
              🔥 Top Prendas Más Vendidas (Filtrado por Variantes)
            </div>
            <div id="top-vendidas-container">
              <!-- Render dinámico con barras de progreso -->
            </div>
          </div>

          <!-- 2. Alertas Automáticas de Stock Mínimo y Sugerencias de Reabastecimiento -->
          <div class="data-card" style="padding: 18px;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 14px;">
              <span style="font-weight:700; color:var(--red-accent); font-size:12px; letter-spacing:1px; text-transform:uppercase;">
                ⚠️ Alertas de Stock Mínimo y Sugerencias
              </span>
              <span style="font-size:10px; color:var(--text-muted);">stock &le; stock_minimo</span>
            </div>
            <div id="alertas-stock-container" class="alertas-stock-list">
              <!-- Render dinámico de tarjetas de alerta -->
            </div>
          </div>

        </div>

      </div>
    </section>

