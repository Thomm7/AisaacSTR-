                  <th>SKU</th>
                  <th>Prenda Base</th>
                  <th>Talla</th>
                  <th>Color</th>
                  <th>Marca</th>
                  <th>P. Compra</th>
                  <th>P. Venta</th>
                  <th>Stock Actual</th>
                  <th>Mín / Máx</th>
                  <th>Estado</th>
                  <th>Acción</th>
                </tr>
              </thead>
              <tbody id="inventario-body">
