    <section id="panel-usuarios" class="panel">
      <div class="module-container">
        <div class="module-header">
          <div class="module-title-box">
            <h2>Gestión de Usuarios</h2>
            <p>Crear cuentas y activar o desactivar usuarios del sistema</p>
          </div>
          <button class="btn-primary" onclick="abrirFormularioUsuario()">Nuevo usuario</button>
        </div>

        <div class="data-card users-management-card">
          <form id="form-crear-usuario" class="users-form" style="display:none; margin-bottom:20px;">
            <label for="usuario-nombre">Nombre completo
              <input id="usuario-nombre" class="auth-input" placeholder="Ej. Ana Pérez" maxlength="150"
                     pattern="[A-Za-zÀ-ÿ\s]+" title="Solo se permiten letras" required />
            </label>
            <label for="usuario-email">Correo electrónico
              <input id="usuario-email" class="auth-input" type="email" maxlength="150" autocomplete="email" placeholder="correo@empresa.com" required />
            </label>
            <label for="usuario-password">Contraseña
              <input id="usuario-password" class="auth-input" type="password" minlength="8" maxlength="128" autocomplete="new-password"
                     pattern="(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z0-9]).{8,}"
                     title="Mínimo 8 caracteres, con mayúscula, minúscula, número y carácter especial"
                     placeholder="8 caracteres mínimos" required />
            </label>
            <label for="usuario-telefono">Teléfono
              <input id="usuario-telefono" class="auth-input" type="tel" maxlength="15" inputmode="tel" pattern="[0-9+\s]+"
                     title="Solo se permiten números, signos más y espacios." placeholder="Ej. +573001234567" />
            </label>
            <label for="usuario-rol">Rol
              <select id="usuario-rol" class="auth-input" required>
                <option value="Cajero">Cajero</option>
                <option value="Administrador">Administrador</option>
              </select>
            </label>
            <div class="users-form-actions">
              <button type="submit" class="btn-primary">Crear cuenta</button>
              <button type="button" class="btn-secondary" onclick="cancelarFormularioUsuario()">Cancelar</button>
            </div>
          </form>
          <div id="usuarios-container" style="max-height:460px; overflow:auto;">Cargando usuarios...</div>
        </div>
      </div>

      <div id="modal-editar-usuario" class="modal-overlay hidden" aria-hidden="true">
        <div class="data-card" style="width:min(520px, calc(100vw - 32px));">
          <div class="module-header">
            <div class="module-title-box">
              <h2>Editar usuario</h2>
              <p>Modifica los datos de la cuenta seleccionada</p>
            </div>
            <button type="button" class="modal-close" aria-label="Cerrar" onclick="cerrarModalEditarUsuario()">×</button>
          </div>
          <form id="form-editar-usuario" class="users-form edit-user-form">
            <input id="editar-usuario-id" type="hidden" />
            <label for="editar-usuario-nombre">Nombre completo
              <input id="editar-usuario-nombre" class="auth-input" maxlength="150"
                     pattern="[A-Za-zÀ-ÿ\s]+"
                     title="Solo se permiten letras" required />
            </label>
            <label for="editar-usuario-email">Correo electrónico
              <input id="editar-usuario-email" class="auth-input" type="email" maxlength="150" required />
            </label>
            <label for="editar-usuario-telefono">Teléfono
              <input id="editar-usuario-telefono" class="auth-input" type="tel" maxlength="15" inputmode="tel"
                     pattern="[0-9+\s]+" title="Solo se permiten números, signos más y espacios." />
            </label>
            <label for="editar-usuario-rol">Rol
              <select id="editar-usuario-rol" class="auth-input" required>
                <option value="Cajero">Cajero</option>
                <option value="Administrador">Administrador</option>
              </select>
            </label>
            <div class="users-form-actions modal-edit-actions" style="display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-top: 24px;">
              <button type="button" class="btn-secondary" onclick="cerrarModalEditarUsuario()">Cancelar</button>
              <button type="submit" class="btn-primary">Guardar cambios</button>
            </div>
          </form>
        </div>
      </div>

      <div id="modal-password-usuario" class="modal-overlay hidden" aria-hidden="true">
        <div class="data-card" style="width:min(520px, calc(100vw - 32px));">
          <div class="module-header">
            <div class="module-title-box">
              <h2>Restablecer contraseña</h2>
              <p>Define una nueva contraseña segura para la cuenta seleccionada</p>
            </div>
            <button type="button" class="modal-close" aria-label="Cerrar" onclick="cerrarModalPasswordUsuario()">×</button>
          </div>
          <form id="form-password-usuario" class="users-form password-reset-form">
