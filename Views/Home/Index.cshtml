                  <th style="position: sticky; top: 0; background-color: #121212; z-index: 10;">Prendas Recibidas</th>
                  <th style="position: sticky; top: 0; background-color: #121212; z-index: 10;">Total Factura</th>
                  <th style="position: sticky; top: 0; background-color: #121212; z-index: 10;">Estado</th>
