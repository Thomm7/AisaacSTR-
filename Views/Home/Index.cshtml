      <div class="gp-tabs-bar" style="display: flex; border-bottom: 1px solid var(--border-subtle); padding: 0 20px; background: rgba(255,255,255,0.02); gap: 6px;">
        <button class="gp-tab-btn active" data-gptab="gptab-entrada" onclick="cambiarSubTabGestion('gptab-entrada')">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
          Entrada de Stock
        </button>
        <button class="gp-tab-btn" data-gptab="gptab-variantes" onclick="cambiarSubTabGestion('gptab-variantes')">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
          Precios y Mín / Máx
        </button>
        <button class="gp-tab-btn" data-gptab="gptab-datos" onclick="cambiarSubTabGestion('gptab-datos')">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          Datos de la Prenda
        </button>
        <button class="gp-tab-btn" data-gptab="gptab-historial" onclick="cambiarSubTabGestion('gptab-historial')">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          Historial de Entradas
        </button>
      </div>

      <div class="modal-body" style="overflow-y: auto; padding: 20px; flex: 1;">
        <!-- TAB 1: ENTRADA DE STOCK (SUMAR AL STOCK EXISTENTE CON AUDITORÍA) -->
        <div id="gptab-entrada" class="gp-tab-content active">
          <div style="background: rgba(212,168,67,0.05); border: 1px solid rgba(212,168,67,0.25); border-radius: 8px; padding: 14px 18px; margin-bottom: 16px;">
            <div style="font-weight: 700; color: var(--gold-bright); font-size: 14px; margin-bottom: 4px;">
              ➕ Registrar Entrada de Unidades
            </div>
            <div style="font-size: 12px; color: var(--text-secondary);">
              Las unidades agregadas se sumarán automáticamente al stock actual de la talla y color elegidos, registrando fecha, hora, cantidad y usuario responsable.
            </div>
          </div>

          <form onsubmit="guardarEntradaStockSubmit(event)" style="display: flex; flex-direction: column; gap: 14px;">
            <div class="form-group" style="margin: 0;">
              <label style="font-size: 12px; font-weight: 600; color: var(--text-secondary); margin-bottom: 6px; display: block;">
                Seleccionar Talla / Color / Variante a Reabastecer *
              </label>
              <select id="gp-entrada-variante-select" class="form-input" style="height: 42px; font-weight: 600;" onchange="actualizarInfoVarianteSeleccionada()">
                <!-- Opciones dinámicas -->
              </select>
            </div>

            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; background: #111; padding: 12px 16px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.08);">
              <div>
                <div style="font-size: 10px; color: var(--text-muted); text-transform: uppercase;">Stock Actual</div>
                <div id="gp-info-stock-actual" style="font-family: 'JetBrains Mono'; font-size: 18px; font-weight: 700; color: var(--text-primary); margin-top: 2px;">0 un.</div>
              </div>
              <div>
                <div style="font-size: 10px; color: var(--text-muted); text-transform: uppercase;">Unidades a Sumar</div>
                <div id="gp-info-stock-sumar" style="font-family: 'JetBrains Mono'; font-size: 18px; font-weight: 700; color: var(--gold-bright); margin-top: 2px;">+5 un.</div>
              </div>
              <div>
                <div style="font-size: 10px; color: var(--text-muted); text-transform: uppercase;">Nuevo Stock Resultante</div>
                <div id="gp-info-stock-nuevo" style="font-family: 'JetBrains Mono'; font-size: 18px; font-weight: 700; color: var(--green-accent); margin-top: 2px;">5 un.</div>
              </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
              <div class="form-group" style="margin: 0;">
                <label style="font-size: 12px; font-weight: 600; color: var(--text-secondary); margin-bottom: 6px; display: block;">
                  Cantidad de Unidades a Ingresar *
                </label>
                <input type="number" id="gp-entrada-cantidad" class="form-input" min="1" step="1" value="5" oninput="calcularNuevoStockEntrada()" style="height: 42px; font-size: 16px; font-family: 'JetBrains Mono'; font-weight: 700;" required />
              </div>
              <div class="form-group" style="margin: 0;">
                <label style="font-size: 12px; font-weight: 600; color: var(--text-secondary); margin-bottom: 6px; display: block;">
                  Usuario Responsable
                </label>
                <input type="text" id="gp-entrada-responsable" class="form-input" style="height: 42px; background: rgba(255,255,255,0.03); opacity: 0.85; cursor: not-allowed;" disabled readonly />
              </div>
            </div>

            <div class="form-group" style="margin: 0;">
              <label style="font-size: 12px; font-weight: 600; color: var(--text-secondary); margin-bottom: 6px; display: block;">
                Motivo / Justificación de la Entrada
              </label>
              <input type="text" id="gp-entrada-motivo" class="form-input" placeholder="Ej: Reabastecimiento de existencias, llegada de pedido, reposición..." value="Reabastecimiento de existencias" />
            </div>

            <div style="display: flex; justify-content: flex-end; margin-top: 8px;">
              <button type="submit" class="btn-primary" style="height: 44px; padding: 0 24px; font-weight: 700;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                Sumar Unidades al Inventario
              </button>
            </div>
          </form>
        </div>

        <!-- TAB 2: PRECIOS Y NIVELES MÍNIMO / MÁXIMO POR VARIANTE -->
        <div id="gptab-variantes" class="gp-tab-content">
          <div style="font-size: 12px; color: var(--text-secondary); margin-bottom: 12px;">
            Ajusta los precios de compra, precios de venta al público y define los umbrales de stock mínimo y máximo para las alertas de reabastecimiento:
          </div>

          <div class="table-responsive" style="max-height: 380px; overflow-y: auto;">
            <table class="custom-table" style="font-size: 12px;">
              <thead>
                <tr>
                  <th>Talla / Color</th>
                  <th>SKU</th>
                  <th style="width: 120px;">P. Compra ($)</th>
                  <th style="width: 120px;">P. Venta ($)</th>
                  <th style="width: 90px;">Mín</th>
                  <th style="width: 90px;">Máx</th>
                  <th>Stock Actual</th>
                  <th>Acción</th>
                </tr>
              </thead>
              <tbody id="gp-variantes-table-body">
                <!-- Inyección JS -->
              </tbody>
            </table>
          </div>
        </div>

        <!-- TAB 3: DATOS GENERALES DEL PRODUCTO -->
        <div id="gptab-datos" class="gp-tab-content">
          <form onsubmit="guardarDatosGeneralesProductoSubmit(event)" style="display: flex; flex-direction: column; gap: 14px;">
            <input type="hidden" id="gp-edit-producto-id" />
            
            <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 12px;">
              <div class="form-group" style="margin: 0;">
                <label style="font-size: 12px; font-weight: 600; color: var(--text-secondary); margin-bottom: 6px; display: block;">Nombre de la Prenda *</label>
                <input type="text" id="gp-edit-nombre" class="form-input" required />
              </div>
              <div class="form-group" style="margin: 0;">
                <label style="font-size: 12px; font-weight: 600; color: var(--text-secondary); margin-bottom: 6px; display: block;">Código Base</label>
                <input type="text" id="gp-edit-codigo" class="form-input" disabled readonly style="opacity: 0.75; cursor: not-allowed;" />
              </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
              <div class="form-group" style="margin: 0;">
                <label style="font-size: 12px; font-weight: 600; color: var(--text-secondary); margin-bottom: 6px; display: block;">Categoría *</label>
                <select id="gp-edit-categoria" class="form-input" style="height: 42px;">
                  <option value="Camisas & Tops">Camisas & Tops</option>
                  <option value="Pantalones & Jeans">Pantalones & Jeans</option>
                  <option value="Bermudas">Bermudas</option>
                  <option value="Calzado">Calzado</option>
                  <option value="Accesorios">Accesorios</option>
                  <option value="Prendas de Vestir">Prendas de Vestir</option>
                </select>
              </div>
              <div class="form-group" style="margin: 0;">
                <label style="font-size: 12px; font-weight: 600; color: var(--text-secondary); margin-bottom: 6px; display: block;">Imagen de la Prenda</label>
                <input type="file" id="gp-edit-imagen" class="form-input" accept="image/jpeg,image/png,image/webp" onchange="actualizarPrevisualizacionImagenGP()" />
              </div>
            </div>

            <div class="form-group" style="margin: 0;">
              <label style="font-size: 12px; font-weight: 600; color: var(--text-secondary); margin-bottom: 6px; display: block;">Descripción de la Prenda</label>
              <textarea id="gp-edit-descripcion" class="form-input" style="height: 60px; padding: 8px 12px; resize: none;"></textarea>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 8px; gap: 12px;">
              <button type="button" class="btn-danger" id="btn-eliminar-producto" onclick="eliminarProductoBaseActual()" style="height: 42px; padding: 0 18px; display: inline-flex; align-items: center; gap: 8px;">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                Eliminar Producto
              </button>
              <button type="submit" class="btn-primary" style="height: 42px; padding: 0 20px;">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                Guardar Datos de la Prenda
              </button>
            </div>
          </form>
        </div>

        <!-- TAB 4: HISTORIAL DE ENTRADAS RECIENTES -->
        <div id="gptab-historial" class="gp-tab-content">
          <div style="font-size: 12px; color: var(--text-secondary); margin-bottom: 12px;">
            Auditoría de ingresos de mercancía registrados para esta prenda:
          </div>

          <div class="table-responsive" style="max-height: 380px; overflow-y: auto;">
            <table class="custom-table" style="font-size: 12px;">
              <thead>
                <tr>
                  <th>Fecha y Hora</th>
                  <th>Variante</th>
                  <th>Cant. Sumada</th>
                  <th>Stock Anterior</th>
                  <th>Stock Nuevo</th>
                  <th>Responsable</th>
                  <th>Motivo</th>
                </tr>
              </thead>
              <tbody id="gp-historial-table-body">
                <!-- Inyección JS -->
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <div class="modal-footer" style="padding: 14px 20px; border-top: 1px solid var(--border-subtle); display: flex; justify-content: space-between; align-items: center;">
        <span style="font-size: 11px; color: var(--text-muted);" id="gp-footer-info">AisaacSTR Control de Inventario</span>
        <button class="btn-secondary" onclick="cerrarModal('modal-gestionar-producto')">Cerrar</button>
      </div>
    </div>
  </div>

  <!-- Modal: Ver Detalle de Factura / Imprimir y Descargar PDF -->
  <div id="modal-detalle-factura" class="modal-overlay hidden">
    <div class="modal-window" style="max-width: 520px; max-height: 92vh; display: flex; flex-direction: column;">
      <div class="modal-header" style="padding-bottom: 12px; border-bottom: 1px solid var(--border-subtle);">
        <div style="display: flex; align-items: center; gap: 8px;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--gold-bright);">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
          <h3 id="mf-header-title" style="font-size: 17px; margin: 0; color: var(--text-primary);">Detalle de Factura</h3>
        </div>
        <button class="modal-close-btn" onclick="cerrarModal('modal-detalle-factura')">&times;</button>
      </div>

      <div class="modal-body" style="overflow-y: auto; padding: 16px; flex: 1;">
        <!-- Contenedor del comprobante imprimible/descargable -->
        <div id="factura-imprimible-area" class="ticket-modal-content" style="padding: 16px; background: #0a0a0a; border: 1px dashed var(--border-gold); border-radius: 8px;">
          <!-- Inyección dinámica de la factura completa -->
        </div>
      </div>

      <div class="modal-footer" style="padding: 12px 18px; border-top: 1px solid var(--border-subtle); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
        <button class="btn-secondary" onclick="cerrarModal('modal-detalle-factura')">Cerrar</button>
        <div style="display: flex; gap: 8px;">
          <button class="btn-secondary" onclick="descargarFacturaPDF()" title="Descargar comprobante en formato PDF">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Descargar PDF
          </button>
          <button class="btn-primary" onclick="imprimirFacturaDetalle()" title="Imprimir ticket / factura">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
            Imprimir Factura
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Contenedor Toast -->
  <div id="toast-container"></div>

  <!-- Script Principal con la Lógica Completa (con cache-buster) -->
  <script src="~/js/app.js?v=@version" asp-append-version="true"></script>
</body>
</html>
