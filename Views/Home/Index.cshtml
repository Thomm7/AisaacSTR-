              </tbody>
            </table>
          </div>

          <!-- Barra de Paginación del Inventario -->
          <div id="inventario-paginacion" class="inventory-pagination">
            <div class="pagination-info" id="inv-paginacion-info">
              Mostrando página <span id="inv-pag-actual">@(ViewBag.PaginaActual ?? 1)</span> de <span id="inv-pag-total">@(ViewBag.TotalPaginas ?? 1)</span> (<span id="inv-total-registros">@(ViewBag.TotalRegistros ?? 0)</span> registros)
            </div>
            <div class="pagination-controls" id="inv-pag-controles">
              <button type="button" class="btn-pagination" id="btn-pag-prev" onclick="cambiarPaginaInventario(inventarioEstado.pagina - 1)" disabled>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
                Anterior
              </button>
              <div class="pagination-numbers" id="inv-pag-numeros">
                <!-- Botones numéricos dinámicos -->
              </div>
              <button type="button" class="btn-pagination" id="btn-pag-next" onclick="cambiarPaginaInventario(inventarioEstado.pagina + 1)">
                Siguiente
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 
         4. PANEL: PROVEEDORES Y COMPRAS
         -->
    <section id="panel-proveedores" class="panel">
      <div class="module-container">
        <div class="module-header">
          <div class="module-title-box">
