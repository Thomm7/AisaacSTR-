@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
    var version = DateTime.UtcNow.Ticks;
}
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AISAAC STR — Retail ERP & POS</title>
  <meta name="description" content="AISAAC STR: Sistema Integral de Gestión Retail con POS, Inventario por Variantes, Cierre de Caja y Dashboard Gerencial" />
  <link rel="icon" type="image/jpeg" href="~/favicon.jpeg" />
  <script>
    document.documentElement.dataset.theme = localStorage.getItem('aisaac-theme') || 'dark';
  </script>
  <link rel="stylesheet" href="~/css/aisaac.css?v=@version" asp-append-version="true" />
  <style>
    /* Estilos Críticos de Autenticación y Layout para asegurar renderizado inmediato */
    .auth-overlay {
      position: fixed !important;
      inset: 0 !important;
      background: rgba(8, 8, 8, 0.94) !important;
      backdrop-filter: blur(14px) !important;
      -webkit-backdrop-filter: blur(14px) !important;
      z-index: 99999 !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      padding: 20px !important;
    }
    .auth-overlay.hidden {
      display: none !important;
    }
    .login-card {
      width: 100% !important;
      max-width: 440px !important;
      background: #111111 !important;
      border: 1px solid rgba(212, 168, 67, 0.45) !important;
      border-radius: 20px !important;
      padding: 34px 28px !important;
      box-shadow: 0 16px 50px rgba(0, 0, 0, 0.9), 0 0 25px rgba(212, 168, 67, 0.25) !important;
      display: flex !important;
      flex-direction: column !important;
      gap: 18px !important;
      position: relative !important;
      overflow: hidden !important;
      font-family: 'Outfit', sans-serif !important;
      color: #f0f0f0 !important;
    }
    .login-card::before {
      content: "";
      position: absolute;
      top: 0; left: 0; right: 0; height: 3px;
      background: linear-gradient(90deg, transparent, #d4a843, transparent);
    }
    .login-header {
      text-align: center !important;
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      gap: 8px !important;
    }
    .login-logo {
      width: 72px !important;
      height: 72px !important;
      max-width: 72px !important;
      max-height: 72px !important;
      border-radius: 14px !important;
      border: 1px solid rgba(212, 168, 67, 0.5) !important;
      box-shadow: 0 0 20px rgba(212, 168, 67, 0.3) !important;
      object-fit: cover !important;
      display: block !important;
    }
    .login-title {
      font-size: 22px !important;
      font-weight: 800 !important;
      color: #d4a843 !important;
      letter-spacing: 2.5px !important;
      margin-top: 4px !important;
    }
    .login-sub {
      font-size: 11px !important;
      color: #888888 !important;
      text-transform: uppercase !important;
      letter-spacing: 1px !important;
    }
    .form-group {
      display: flex !important;
      flex-direction: column !important;
      gap: 5px !important;
      text-align: left !important;
    }
    .form-group label {
      font-size: 11px !important;
      font-weight: 600 !important;
      color: #888888 !important;
      text-transform: uppercase !important;
      letter-spacing: 1px !important;
    }
    .form-input {
      width: 100% !important;
      height: 42px !important;
      padding: 0 14px !important;
      background: #181818 !important;
      border: 1px solid rgba(255, 255, 255, 0.12) !important;
      border-radius: 8px !important;
      color: #f0f0f0 !important;
      font-family: inherit !important;
      font-size: 13px !important;
      box-sizing: border-box !important;
    }
    .form-input:focus {
      outline: none !important;
      border-color: #d4a843 !important;
      box-shadow: 0 0 12px rgba(212, 168, 67, 0.3) !important;
    }
    .login-btn {
      height: 44px !important;
      background: linear-gradient(135deg, #b8922d, #d4a843) !important;
      border: none !important;
      border-radius: 8px !important;
      color: #080808 !important;
      font-weight: 700 !important;
      font-size: 13px !important;
      letter-spacing: 1.5px !important;
      text-transform: uppercase !important;
      cursor: pointer !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      gap: 8px !important;
      transition: all .2s !important;
    }
    .login-btn:hover {
      filter: brightness(1.15) !important;
      box-shadow: 0 0 20px rgba(212, 168, 67, 0.4) !important;
    }

    /* Modales Críticos */
    .modal-overlay {
      position: fixed !important;
      inset: 0 !important;
      background: rgba(0, 0, 0, 0.85) !important;
      backdrop-filter: blur(8px) !important;
      z-index: 9999 !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      padding: 20px !important;
    }
    .modal-overlay.hidden { display: none !important; }
    .modal-window {
      width: 100% !important;
      max-width: 600px !important;
      max-height: 90vh !important;
      overflow-y: auto !important;
      background: #111111 !important;
      border: 1px solid rgba(212, 168, 67, 0.4) !important;
      border-radius: 18px !important;
      padding: 24px !important;
      box-shadow: 0 10px 40px rgba(0,0,0,0.8), 0 0 20px rgba(212, 168, 67, 0.2) !important;
      display: flex !important;
      flex-direction: column !important;
      gap: 16px !important;
      color: #f0f0f0 !important;
    }
  </style>
</head>
<body>

  <!-- ══════════════════════════════════════════
       MÓDULO DE AUTENTICACIÓN / LOGIN MODAL
       ══════════════════════════════════════════ -->
  <div id="auth-overlay" class="auth-overlay">
    <div class="login-card">
      <div class="login-header">
        <img src="~/img/logo.jpeg" alt="AISAAC STR" class="login-logo" width="72" height="72" style="width: 72px; height: 72px; max-width: 72px; max-height: 72px; object-fit: cover; border-radius: 14px;" />
        <div class="login-title">AISAAC STR</div>
        <div class="login-sub">Sistema de Gestión Retail · Campoalegre, Huila</div>
      </div>

      <form id="login-form" onsubmit="handleLogin(event); return false;">
        <div class="form-group">
          <label>Correo Electrónico</label>
          <input type="email" id="login-email" class="form-input" placeholder="usuario@aisaacstr.com" required autocomplete="email" />
        </div>

        <div class="form-group" style="margin-top: 8px;">
          <label>Contraseña</label>
          <input type="password" id="login-password" class="form-input" placeholder="••••••••" required autocomplete="current-password" />
        </div>

        <button type="submit" class="login-btn" id="login-submit-btn" style="margin-top: 14px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
            <polyline points="10 17 15 12 10 7"/>
            <line x1="15" y1="12" x2="3" y2="12"/>
          </svg>
          Iniciar Sesión
        </button>
      </form>
    </div>
  </div>

  <!-- ══════════════════════════════════════════
       TOP BAR
       ══════════════════════════════════════════ -->
  <header id="topbar">
    <div class="brand">
      <img src="~/img/logo.jpeg" alt="AISAAC STR Logo" class="brand-logo-img" />
      <div>
        <div class="brand-name">AISAAC STR</div>
        <div class="brand-sub">Retail & Fashion ERP</div>
      </div>
    </div>

    <div class="topbar-right">
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Cambiar a modo claro" title="Cambiar tema">
        <span class="theme-toggle-icon" aria-hidden="true">☀</span>
      </button>
      <!-- Botón Desplegable del Carrito de Compras -->
      <button class="topbar-cart-btn" id="btn-toggle-cart" onclick="abrirModalCarrito()" title="Ver carrito de compras">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>
        <span>Carrito</span>
        <span class="cart-pill-badge" id="topbar-cart-count">0</span>
      </button>

      <!-- Botón de Estado de Caja (Abrir / Cerrar) -->
      <button class="topbar-caja-btn cerrada" id="btn-topbar-caja" onclick="manejarClickBotonCajaTopbar()" title="Control de Caja">
        <span class="caja-status-dot red" id="topbar-caja-dot"></span>
        <span id="topbar-caja-text">Caja: Cerrada</span>
      </button>

      <!-- Info de Usuario y Rol RBAC -->
      <div id="user-info-box" class="user-badge" style="display: none;">
        <span id="user-name-display">Usuario</span>
        <span id="user-role-display" class="role-pill admin">ADMIN</span>
        <button class="logout-btn" onclick="logout()" title="Cerrar Sesión">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
            <polyline points="16 17 21 12 16 7"/>
            <line x1="21" y1="12" x2="9" y2="12"/>
          </svg>
          Salir
        </button>
      </div>

      <span class="topbar-date" id="topbar-time">cargando...</span>
      <div class="status-badge">
        <span class="status-dot"></span>
        <span id="db-status-label">En Línea (DB)</span>
      </div>
    </div>
  </header>

  <!-- ══════════════════════════════════════════
       NAV TABS (CON CONTROL RBAC)
       ══════════════════════════════════════════ -->
  <nav id="nav-tabs">
    <!-- Visible para todos (Cajero y Admin) -->
    <button class="tab-btn active" data-panel="panel-pdv" id="tab-pdv" data-role="all">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>
      </svg>
      Punto de Venta
    </button>
    <button class="tab-btn" data-panel="panel-cierre" id="tab-cierre" data-role="all">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 2v20M2 12h20"/><circle cx="12" cy="12" r="9"/>
      </svg>
      Cierre de Caja
    </button>

    <!-- Exclusivos de Administrador / Gerente -->
    <button class="tab-btn admin-only" data-panel="panel-inventario" id="tab-inventario" data-role="admin">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
        <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
        <line x1="12" y1="22.08" x2="12" y2="12"/>
      </svg>
      Inventario y Variantes
    </button>
    <button class="tab-btn admin-only" data-panel="panel-proveedores" id="tab-proveedores" data-role="admin">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/>
      </svg>
      Proveedores y Compras
    </button>
    <button class="tab-btn admin-only" data-panel="panel-dashboard" id="tab-dashboard" data-role="admin">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>
      </svg>
      Dashboard Gerencial
    </button>
    <button class="tab-btn admin-only" data-panel="panel-usuarios" id="tab-usuarios" data-role="admin">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
        <circle cx="8.5" cy="7" r="4"/>
        <path d="M20 8v6M23 11h-6"/>
      </svg>
      Gestión de Usuarios
    </button>
    <button class="tab-btn" data-panel="panel-historial" id="tab-historial" data-role="all">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M3 3h18v18H3z"/><path d="M7 7h10M7 12h10M7 17h6"/>
      </svg>
      Historial de Ventas
    </button>
  </nav>

  <!-- ══════════════════════════════════════════
       CONTENIDO PRINCIPAL
       ══════════════════════════════════════════ -->
  <main id="app-body">

    <!-- ──────────────────────────────────────────
         1. PANEL: PUNTO DE VENTA (POS)
         ────────────────────────────────────────── -->
    <section id="panel-pdv" class="panel active">
      <div class="pdv-left">
        <!-- Barra de Búsqueda y Filtros Rápidos (Chips modernos) -->
        <div class="pos-catalog-header">
          <div class="pos-search-line">
            <div class="search-input-wrap">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
              </svg>
              <input id="search-producto" type="text"
                placeholder="Escribe camisa, pantalón, calzado o SKU para filtrar..." autocomplete="off" />
              <button type="button" id="btn-clear-search" class="clear-search-btn" style="display: none;" onclick="limpiarBusquedaPOS()" title="Borrar búsqueda">✕</button>
            </div>
            <div class="pos-catalog-stats" id="pos-catalog-count">
              Cargando catálogo...
            </div>
          </div>

          <!-- Filtros de categoría rápidos tipo chips -->
          <div class="pos-category-chips" id="pos-category-chips">
            <button type="button" class="chip-btn active" data-categoria="" onclick="seleccionarChipCategoria(this, '')">Todas</button>
            <button type="button" class="chip-btn" data-categoria="camisas" onclick="seleccionarChipCategoria(this, 'camisas')">👔 Camisas</button>
            <button type="button" class="chip-btn" data-categoria="pantalones" onclick="seleccionarChipCategoria(this, 'pantalones')">👖 Jeans & Pantalones</button>
            <button type="button" class="chip-btn" data-categoria="bermudas" onclick="seleccionarChipCategoria(this, 'bermudas')">🩳 Bermudas</button>
            <button type="button" class="chip-btn" data-categoria="calzado" onclick="seleccionarChipCategoria(this, 'calzado')">👟 Zapatos</button>
            <button type="button" class="chip-btn" data-categoria="accesorios" onclick="seleccionarChipCategoria(this, 'accesorios')">🎒 Accesorios</button>
          </div>
        </div>

        <!-- Muestra interactiva de prendas en stock (Grid dinámico) -->
        <div class="pos-catalog-container">
          <div id="pos-catalog-grid" class="pos-catalog-grid">
            <!-- Renderizado dinámicamente desde app.js -->
          </div>
        </div>
      </div>

  <!-- Modal: Carrito de Compras / Orden Actual (Desplegable) -->
  <div id="modal-carrito" class="modal-overlay hidden">
    <div class="modal-window cart-modal-window" style="max-width: 500px;">
      <div class="modal-header">
        <div class="cart-modal-title-box">
          <span class="cart-icon" style="font-size: 22px;">🛍️</span>
          <div>
            <h3 style="margin: 0; font-size: 16px;">Carrito de Compras</h3>
            <span class="cart-badge-count" id="cart-badge-count" style="margin-top: 2px; display: inline-block;">0 prendas</span>
          </div>
        </div>
        <button class="modal-close-btn" onclick="cerrarModalCarrito()">&times;</button>
      </div>

      <div class="modal-body pos-checkout-grid">
        <section class="pos-checkout-card pos-order-card">
          <div class="payment-section-title">Orden del cliente</div>
          <div class="cart-items-wrapper">
            <div id="cart-body" class="cart-items-list"><!-- Render dinámico desde app.js --></div>
          </div>
          <div class="summary-block">
            <div class="summary-row"><span>Subtotal</span><span class="summary-val" id="sum-subtotal">$ 0</span></div>
            <div class="summary-row"><span>Descuentos</span><span class="summary-val" id="sum-descuentos">$ 0</span></div>
            <div class="summary-row"><span>IVA (0%)</span><span class="summary-val" id="sum-iva">$ 0</span></div>
            <div class="summary-row total-row"><span>TOTAL A COBRAR</span><span class="summary-val" id="sum-total">$ 0</span></div>
          </div>
        </section>

        <section class="pos-checkout-card pos-payment-card">
          <div class="payment-section-title">Método de pago</div>
          <div class="payment-methods" id="payment-methods-container">
            <div class="pay-method-card" data-method="1" data-flujo="Efectivo" id="pay-efectivo">
              <div class="pay-icon efectivo">💵</div><div class="pay-info"><div class="pay-name">Efectivo</div><div class="pay-desc">Pago directo en efectivo</div></div>
            </div>
            <div class="pay-method-card" data-method="2" data-flujo="Transferencia" id="pay-transferencia">
              <div class="pay-icon transferencia">🏦</div><div class="pay-info"><div class="pay-name">Transferencia</div><div class="pay-desc">Nequi · Daviplata · Bancolombia</div></div>
            </div>
            <div class="pay-method-card" data-method="3" data-flujo="Credito" data-proveedor="Sistecrédito" id="pay-sistecredito">
              <div class="pay-icon credito">💳</div><div class="pay-info"><div class="pay-name">Sistecrédito</div><div class="pay-desc">Crédito en cuotas</div></div>
            </div>
            <div class="pay-method-card" data-method="4" data-flujo="Credito" data-proveedor="Addi" id="pay-addi">
              <div class="pay-icon credito">💳</div><div class="pay-info"><div class="pay-name">Addi</div><div class="pay-desc">Crédito digital inmediato</div></div>
            </div>
          </div>

          <div id="pos-payment-details" class="pos-payment-details">
            <div id="payment-cash-fields" class="payment-extra-fields" hidden>
              <label for="efectivo-recibido">Efectivo recibido</label>
              <input id="efectivo-recibido" class="pos-payment-input" type="number" min="0" inputmode="decimal" placeholder="0">
              <div id="payment-change-row" class="payment-change-row"><span>Vueltas / cambio</span><strong id="payment-change">$ 0</strong></div>
            </div>
            <div id="payment-transfer-fields" class="payment-extra-fields" hidden>
              <label for="transfer-banco">Banco / billetera</label>
              <select id="transfer-banco" class="pos-payment-input">
                <option value="">Seleccione una opción</option>
                <option>Nequi</option><option>Daviplata</option><option>Bancolombia</option>
              </select>
              <label for="transfer-referencia">Comprobante o referencia</label>
              <input id="transfer-referencia" class="pos-payment-input" maxlength="100" placeholder="Número de comprobante">
            </div>
            <div id="payment-credit-fields" class="payment-extra-fields" hidden>
              <label for="credit-aprobacion">Código de aprobación</label>
              <input id="credit-aprobacion" class="pos-payment-input" maxlength="100" placeholder="Código aprobado por el proveedor">
            </div>
          </div>

          <button class="process-btn-large" id="process-btn" disabled onclick="ejecutarVentaBackend()">
            PROCESAR VENTA Y GENERAR TICKET
          </button>
        </section>
      </div>
    </div>
  </div>
    </section>

    <!-- ──────────────────────────────────────────
         2. PANEL: CIERRE DE CAJA Y ARQUEO
         ────────────────────────────────────────── -->
    <section id="panel-cierre" class="panel">
      <div class="module-container" style="align-items: center;">
        <div class="cierre-header">
          <div class="cierre-date" id="cierre-date-label">HOY</div>
          <div class="cierre-title">Módulo de Cierre y Arqueo de Caja</div>
          <div class="cierre-subtitle">Conciliación discriminada: Efectivo vs Bancos vs Sistecrédito</div>
        </div>

        <!-- Banner Dinámico de Estado de Turno: Abierta vs Cerrada -->
        <div id="cierre-shift-banner" class="cierre-shift-card cerrada">
          <div style="display: flex; align-items: center; gap: 12px;">
            <span class="shift-status-badge cerrada" id="shift-badge-text">🔴 Caja Cerrada</span>
            <div>
              <div style="font-weight: 700; font-size: 15px; color: var(--text-primary);" id="shift-title-text">No hay un turno de caja activo</div>
              <div style="font-size: 12px; color: var(--text-muted);" id="shift-desc-text">Inicia el turno registrando la base de efectivo para comenzar a facturar.</div>
            </div>
          </div>
          <button class="btn-abrir-caja-action" id="btn-abrir-caja-banner" onclick="abrirModalAperturaCaja()">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 9.9-1"></path>
            </svg>
            Abrir caja
          </button>
        </div>

        <!-- KPIs discriminados del turno -->
        <div class="cierre-kpis" id="cierre-kpis-container">
          <div class="kpi-card base">
            <span class="kpi-badge">🏦 Base Inicial</span>
            <div class="kpi-label">Fondo de Apertura</div>
            <div class="kpi-value" id="kpi-base-display">$ 0</div>
            <div class="kpi-hint" id="kpi-base-hint">Base con que inició la caja</div>
          </div>
          <div class="kpi-card efectivo">
            <span class="kpi-badge">💵 Ventas Efectivo</span>
            <div class="kpi-label">Cobros en Efectivo (+)</div>
            <div class="kpi-value" id="kpi-efectivo">$ 0</div>
            <div class="kpi-hint">Ingresos por ventas de hoy</div>
          </div>
          <div class="kpi-card egreso">
            <span class="kpi-badge">📉 Pagos Proveedores</span>
            <div class="kpi-label">Egresos de Caja (-)</div>
            <div class="kpi-value" id="kpi-egresos">$ 0</div>
            <div class="kpi-hint">Compras pagadas en efectivo</div>
          </div>
          <div class="kpi-card transferencia">
            <span class="kpi-badge">🏦 Bancos</span>
            <div class="kpi-label">Transferencias Bancarias</div>
            <div class="kpi-value" id="kpi-transferencia">$ 0</div>
            <div class="kpi-hint">Nequi · Daviplata · PSE</div>
          </div>
          <div class="kpi-card credito">
            <span class="kpi-badge">💳 Cartera</span>
            <div class="kpi-label">Ventas a Crédito</div>
            <div class="kpi-value" id="kpi-credito">$ 0</div>
            <div class="kpi-hint">Sistecrédito · Addi</div>
          </div>
        </div>

        <!-- Total de la jornada -->
        <div class="cierre-total-row">
          <div>
            <div class="cierre-total-label">Venta Total Consolidada del Día</div>
            <div style="font-size:11px; color:var(--text-secondary); margin-top:2px;">
              Efectivo + Transferencias + Crédito
            </div>
          </div>
          <div class="cierre-total-val" id="cierre-total">$ 0</div>
        </div>

        <!-- Arqueo de Caja Físico y Descuadre con Deducción de Proveedores -->
        <div class="cierre-bottom" id="cierre-arqueo-section">
          <div class="cierre-box">
            <div class="cierre-box-title">Arqueo de Caja — Base y Conteo Físico Real</div>
            
            <div class="cierre-money-grid">
              <div class="cierre-money-field">
                <label for="cierre-monto-inicial">
                  <span class="field-step">1</span> Base Inicial (Fija / Protegida 🔒)
                </label>
                <div class="money-input-wrap">
                  <span class="money-prefix">$</span>
                  <input type="number" id="cierre-monto-inicial" value="0" min="0" step="1000" disabled readonly style="background: rgba(255,255,255,0.03); opacity: 0.85; cursor: not-allowed;" title="La base inicial queda bloqueada tras la apertura de caja." />
                </div>
              </div>
              <div class="cierre-money-field">
                <label for="efectivo-contado">
                  <span class="field-step">2</span> Efectivo contado en cajón (Físico) *
                </label>
                <div class="money-input-wrap">
                  <span class="money-prefix">$</span>
                  <input type="number" id="efectivo-contado" placeholder="0" min="0" step="1000" oninput="calcDiferenciaCierre()" />
                </div>
              </div>
            </div>

            <div class="esperado-note" style="background: rgba(212,168,67,0.08); padding: 10px 14px; border-radius: 8px; border: 1px solid rgba(212,168,67,0.25);">
              <div style="display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 12px; color: var(--text-secondary);">Total Efectivo Esperado en Caja:</span>
                <strong id="esperado-val" style="color: var(--gold-bright); font-size: 16px; font-family: 'JetBrains Mono';">$ 0</strong>
              </div>
              <div style="font-size:10px; color:var(--text-muted); margin-top:4px;">
                Fórmula: Base (<span id="calc-base">$ 0</span>) + Ventas Efectivo (<span id="calc-ventas">$ 0</span>) − Egresos Proveedores (<span id="calc-egresos">$ 0</span>)
              </div>
            </div>
          </div>

          <div class="cierre-box">
            <div class="cierre-box-title">Comparación y Conciliación Final</div>
            <div class="diferencia-display">
              <div class="dif-row">
                <span>Efectivo Contado</span>
                <span>vs Efectivo Esperado</span>
              </div>
              <div class="dif-val" id="diferencia-val">—</div>
              <div style="font-size:11px; color:var(--text-muted); margin-top:4px;" id="dif-status-text">
                Ingresa el valor contado físicamente en cajón para auditar
              </div>
            </div>
          </div>
        </div>

        <!-- Lista de Pagos/Egresos a Proveedores en el Turno Activo -->
        <div class="cierre-box" style="width: 100%; max-width: 900px;" id="cierre-egresos-container">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
            <div class="cierre-box-title" style="margin-bottom: 0;">📉 Pagos y Egresos a Proveedores con Efectivo de Tienda (Turno Activo)</div>
            <span id="cierre-egresos-count" style="font-size: 11px; color: #ff6b6b; font-weight: 600;">0 comprobante(s)</span>
          </div>
          <div id="cierre-egresos-list" style="max-height: 140px; overflow-y: auto;">
            <div style="font-size: 11px; color: var(--text-muted); padding: 8px 0;">No se registran egresos de compras en efectivo para este turno.</div>
          </div>
        </div>

        <div style="width: 100%; max-width: 900px; margin-top: 10px;" id="cierre-obs-wrapper">
          <textarea id="cierre-observaciones" class="form-input" style="height: 60px; padding: 8px 12px; resize: none;" placeholder="Observaciones o notas sobre el arqueo diario..."></textarea>
        </div>

        <!-- Botones de Acción de Cierre -->
        <div style="display: flex; gap: 12px; width: 100%; max-width: 900px;" id="cierre-action-buttons">
          <button class="cierre-confirm-btn" id="confirmar-cierre-btn" onclick="ejecutarCierreBackend()">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            Cerrar caja y Guardar Arqueo en PostgreSQL
          </button>
        </div>
      </div>
    </section>

    <!-- ──────────────────────────────────────────
         3. PANEL: GESTIÓN DE INVENTARIO Y VARIANTES
         ────────────────────────────────────────── -->
    <section id="panel-inventario" class="panel">
      <div class="module-container">
        <div class="module-header">
          <div class="module-title-box">
            <h2>Gestión de Inventario y Matriz de Variantes</h2>
            <p>Control exacto por prenda, talla, marca, color, SKU y niveles de existencias</p>
          </div>
          <div class="module-actions">
            <button class="btn-primary" onclick="abrirModalNuevoProducto()">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
