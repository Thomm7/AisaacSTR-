                  <th style="position: sticky; top: 0; background-color: #121212; z-index: 10;">Contacto</th>
                  <th style="position: sticky; top: 0; background-color: #121212; z-index: 10;">Teléfono</th>
                  <th style="position: sticky; top: 0; background-color: #121212; z-index: 10;">Email</th>
                  <th style="position: sticky; top: 0; background-color: #121212; z-index: 10;">Ciudad</th>
                  <th style="position: sticky; top: 0; background-color: #121212; z-index: 10;">Compras Reg.</th>
